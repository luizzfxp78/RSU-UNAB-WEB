# Copia este archivo como .env y completa tus valores privados. NO publiques .env.
APP_NAME=RSU UNAB WEB
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
# La interfaz utiliza el mismo origen que FastAPI. No necesitas CORS amplio.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rsu_web
DB_PASSWORD=CAMBIA_AQUI_TU_CLAVE_MYSQL
DB_NAME=rsu_unab
# Genera una clave con: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=GENERA_UNA_CLAVE_ALEATORIA_LARGA
ACCESS_TOKEN_EXPIRE_MINUTES=120
DEMO_ALLOW_PLACEHOLDER_PASSWORDS=false
UPLOAD_DIR=uploads
PRIVATE_STORAGE_DIR=private_storage
# Windows: ruta a LibreOffice para convertir anexos DOCX a PDF
LIBREOFFICE_PATH=
PDF_CONVERTER_ORDER=libreoffice,word

# SOLO para ensayos locales y expedientes cuyo titulo inicia con [PRUEBA].
# Mantener false en sistemas de uso real o producción.
RSU_ENABLE_TEST_ADVANCE=false

# TLS CA certificate path if supplied by remote MySQL provider (do not commit actual CA if sensitive)
DB_SSL_CA=
